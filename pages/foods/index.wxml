<view class="page-shell">
  <view class="food-visual"><image src="/assets/meal-hero.jpg" mode="aspectFill" /><view><view class="eyebrow">KNOW YOUR FOOD</view><view class="section-title small">每一口，心里有数</view><view class="weight-guide">选对食物，也看清生重与熟重</view></view></view>
  <view class="card meat-card">
    <view class="eyebrow">MEAT PROTEIN</view>
    <view class="section-title small">肉类蛋白质速查</view>
    <view class="weight-guide">{{presetMeatCount}} 种常见肉类 / 部位，可搜索；按生重或熟重输入克数。</view>
    <view class="input-wrap"><input value="{{meatQuery}}" bindinput="onMeatSearch" placeholder="搜索肉类，例如 鸡腿、羊肉、虾" aria-label="搜索肉类" maxlength="40" /></view>
    <view class="field-label meat-label">选择肉类</view>
    <picker mode="selector" disabled="{{!meatOptions.length}}" range="{{meatOptions}}" range-key="label" value="{{meatIndex}}" bindchange="onMeatChange" aria-label="选择肉类及部位">
      <view class="meat-picker"><text>{{meatOptions.length ? meatOptions[meatIndex].label : '暂无匹配食物'}}</text><text class="meat-arrow">更换 ▾</text></view>
    </picker>
    <view wx:if="{{meatSaveMessage}}" class="weight-guide">{{meatSaveMessage}}</view>
    <view class="weight-guide">每 100 g 可食部参考。生重和熟重分别称取，不代表同一块肉做熟前后。</view>
    <view wx:if="{{meatBasis}}" class="reference-pair">
      <view><text class="weight-badge">生重 · 可食部</text><block wx:if="{{meatBasis.raw}}"><view class="reference-value">{{meatBasis.raw.protein}} <text>g 蛋白质</text></view><view wx:if="{{meatBasis.raw.calories !== null}}" class="food-note">{{meatBasis.raw.calories}} kcal / 100 g</view><view wx:else class="food-note">未提供热量</view></block><view wx:else class="food-note">暂无生重数据</view></view>
      <view><text class="weight-badge">熟重 · {{selectedCookedLabel}}</text><block wx:if="{{meatBasis.cooked}}"><view class="reference-value">{{meatBasis.cooked.protein}} <text>g 蛋白质</text></view><view wx:if="{{meatBasis.cooked.calories !== null}}" class="food-note">{{meatBasis.cooked.calories}} kcal / 100 g</view><view wx:else class="food-note">未提供热量</view></block><view wx:else class="food-note">暂无熟重数据</view></view>
    </view>
    <view wx:if="{{meatBasis}}" class="weight-guide"><view wx:if="{{meatBasis.raw}}">生重：{{meatBasis.raw.note}}</view><view wx:if="{{meatBasis.cooked}}">熟重：{{meatBasis.cooked.note}}</view><view wx:if="{{!meatBasis.raw || !meatBasis.cooked}}">未提供的状态不参与计算，请勿套用另一状态的数据。</view></view>
    <view class="field-label">输入所选肉类重量，分别查看生重 / 熟重结果</view>
    <view class="input-wrap"><input type="digit" value="{{meatGrams}}" bindinput="onMeatInput" placeholder="例如 150" aria-label="所选肉类重量（克）" /><text class="unit">g</text></view>
    <view wx:if="{{meatError}}" class="plan-warning">{{meatError}}</view>
    <view wx:if="{{meatResult}}" class="calculator-results">
      <view wx:if="{{meatResult.raw}}">若为 {{meatResult.raw.grams}} g 生重：约 <text class="food-grams">{{meatResult.raw.protein}} g 蛋白质</text><text wx:if="{{meatResult.raw.calories !== null}}">，{{meatResult.raw.calories}} kcal</text></view>
      <view wx:if="{{meatResult.cooked}}">若为 {{meatResult.cooked.grams}} g 熟重（{{selectedCookedLabel}}）：约 <text class="food-grams">{{meatResult.cooked.protein}} g 蛋白质</text><text wx:if="{{meatResult.cooked.calories !== null}}">，{{meatResult.cooked.calories}} kcal</text></view>
    </view>
    <view class="weight-guide">熟肉每 100 g 的蛋白质通常更集中，主要因为烹调失水，并不是凭空增加蛋白质。部位、肥瘦和做法会影响数值。</view>
    <view class="weight-guide">计算方式：食物克数 ÷ 100 × 对应状态的每 100 g 营养值。若要知道同一批肉的生熟重量关系，请分别称量烹调前后总重；本工具不使用固定缩水比例。</view>
    <view wx:if="{{meatBasis}}">
      <view wx:if="{{!meatIsCustom}}" class="source-actions"><button wx:if="{{meatBasis.raw}}" size="mini" data-id="{{meatBasis.raw.id}}" bindtap="copyFoodSource">复制生重来源</button><button wx:if="{{meatBasis.cooked}}" size="mini" data-id="{{meatBasis.cooked.id}}" bindtap="copyFoodSource">复制熟重来源</button></view>
      <view wx:if="{{!meatIsCustom}}" class="food-note">USDA SR Legacy：<text wx:if="{{meatBasis.raw}}">生重 {{meatBasis.raw.sourceId}} </text><text wx:if="{{meatBasis.cooked}}">熟重 {{meatBasis.cooked.sourceId}}</text>。</view>
      <view wx:else class="food-note">用户录入：{{customForm.source || '未填写来源'}}。结果仅依据你填写的数据；kJ 按 1 kcal = 4.184 kJ 换算。</view>
    </view>
    <view class="food-note">数值为近似参考；生重指烹调前称量，肉类请做熟后食用。</view>
  </view>

  <view class="method-card">
    <view class="method-head" bindtap="toggleFoods"><text>食物营养参考表 · 每 100 g</text><text>{{showFoods ? '收起' : '展开'}}</text></view>
    <view wx:if="{{showFoods}}" class="food-reference-list">
      <view wx:for="{{foodReferences}}" wx:key="id" class="food-row">
        <view class="food-title">{{item.name}} <text class="weight-badge">{{item.state}}</text></view>
        <view class="food-nutrients">{{item.calories}} kcal · 蛋白 {{item.protein}} g · 碳水 {{item.carbs}} g · 脂肪 {{item.fat}} g</view><view class="food-nutrients">膳食纤维：{{item.fiberLabel}}</view>
        <view class="food-note">{{item.note}}</view>
        <button size="mini" class="source-link" data-id="{{item.id}}" bindtap="copyFoodSource">复制数据来源</button>
      </view>
    </view>
  </view>

  <view class="safe-bottom"></view>
</view>
