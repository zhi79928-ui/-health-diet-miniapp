<view class="screen">
  <view wx:if="{{reminderSyncError}}" class="notice">{{reminderSyncError}}</view>
  <view class="topline flow-header"><view><view class="eyebrow">每天，从一餐开始</view><view class="title">今日饮食</view></view><view class="header-actions"><picker mode="date" value="{{selectedDate}}" end="{{today}}" bindchange="onDateChange"><view class="date-pill">{{selectedDate}} ▾</view></picker><button class="guide-button" size="mini" bindtap="openGuide">?</button></view></view>
  <view wx:if="{{guideOpen}}" class="panel guide-panel">
    <view class="heading">第一次用？照这三步记</view>
    <view class="guide-step"><text class="badge">1</text><view>选食物，填实际克数<view class="muted">烹调前称选生重，烹调后称选对应熟重；燕麦等干食材按条目的干重填写。水果称可食部分，油单独添加。</view></view></view>
    <view class="guide-step"><text class="badge">2</text><view>吃完后，记录这餐<view class="muted">添加食物只是准备餐次。确认实际吃的份量，再点“按以上食物记录这餐”，才会计入已吃合计。</view></view></view>
    <view class="guide-step"><text class="badge">3</text><view>主动完成今日打卡<view class="muted">当天记录任意一餐或体重后即可打卡，不必等四餐齐全。餐次记录和每日打卡是两步。</view></view></view>
    <view class="muted space">免登录也能记录。数据默认保存在本机，登录后到“我的”手动备份；换设备或清缓存前先备份。</view>
    <button class="primary space" bindtap="closeGuide">知道了，开始记录</button>
  </view>
  <view wx:if="{{error}}" class="notice">{{error}}</view>
  <view wx:if="{{day}}" class="panel daily-overview">
    <view class="overview-head"><view><view class="section-label">{{selectedDate === today ? '今天已摄入' : '所选日期已摄入'}}</view><view class="intake-energy"><text>{{day.consumed.calories}}</text><text class="energy-unit"> kcal</text></view></view><view class="meal-count"><text>{{day.completed}}</text><view>已记录 / 4 餐</view></view></view>
    <view class="dashboard-grid compact-grid">
      <view><text class="dashboard-value">{{day.consumed.protein}} g</text><text class="metric-label">蛋白质</text></view>
      <view><text class="dashboard-value">{{day.consumed.fiber}} g</text><text class="metric-label">膳食纤维</text></view>
      <view><text class="dashboard-value">{{day.consumed.carbs}} g</text><text class="metric-label">碳水</text></view>
    </view>
    <view class="next-meal-card"><view><view class="strong">下一餐 · {{day.dashboard.nextMealName}}</view><view wx:if="{{day.dashboard.calorieTarget}}" class="mini-note">参考热量剩余 {{day.dashboard.calorieRemaining}} kcal</view></view><button wx:if="{{selectedDate === today && day.dashboard.nextMealIndex >= 0}}" size="mini" class="small-button" bindtap="openRecommendation">搭配建议</button></view>
    <view wx:for="{{day.alerts}}" wx:key="*this" class="notice compact-notice">{{item}}</view>
    <view class="meal-shortcuts"><button wx:for="{{day.meals}}" wx:key="name" class="meal-shortcut {{item.logged ? 'recorded' : ''}}" data-meal="{{index}}" bindtap="jumpMeal"><view>{{item.name}}</view><text>{{item.logged ? '已记录 ✓' : '去记录 ↓'}}</text></button></view>
  </view>
  <view id="daily-checkin" class="panel habit-panel compact-habit">
    <view><view class="topline"><view class="heading">{{habit.done ? '今日已打卡 ✓' : '今日打卡'}}</view><text class="badge">连续 {{habit.streak || 0}} 天</text></view><view class="mini-note">{{tasks.meals ? '已记录 ' + tasks.meals + ' 餐' : tasks.weight ? '今天已记录体重' : '记录一餐后即可打卡'}}</view></view>
    <view wx:if="{{habitError}}" class="notice">{{habitError}}</view>
    <button class="checkin-button" disabled="{{habit.done || habitError || (tasks.meals ? false : !tasks.weight)}}" bindtap="completeCheckin">{{habit.done ? '已完成' : '打卡'}}</button>
  </view>
  <view class="quick-actions"><button class="secondary" bindtap="openLibrary">★ 我的常吃</button><button class="secondary" bindtap="goPlan">调整计划</button><button class="secondary" bindtap="goProgress">打卡日历</button></view>
  <view wx:if="{{!day}}" class="panel empty">
    <view class="heading">{{selectedDate === today ? '从今天的一餐开始' : '这一天还没有计划'}}</view>
    <view class="muted">可以从空白餐次添加实际食物，也可以先生成参考食谱。吃完再记录。</view>
    <button class="primary" bindtap="startDiary">直接记饮食 · 自己搭配每一餐</button>
    <button class="secondary" bindtap="goPlan">设置目标与生成方案</button>
    <button class="secondary" bindtap="copyYesterday">沿用前一天的食谱</button>
    <view class="muted">无需注册也能使用；记录默认保存在本机，登录后可主动备份。</view>
  </view>
  <block wx:if="{{day}}">
    <view wx:for="{{day.warnings}}" wx:key="*this" class="notice">{{item}}</view>
    <view id="meal-{{mealIndex}}" class="panel meal-card {{expandedMeal === mealIndex ? 'expanded' : ''}}" wx:for="{{day.meals}}" wx:for-item="meal" wx:for-index="mealIndex" wx:key="name">
      <view class="meal-card-head" data-meal="{{mealIndex}}" bindtap="toggleMealDetails">
        <view class="meal-title-row"><view class="heading">{{meal.name}}</view><text class="status-dot {{meal.logged ? 'done' : ''}}"></text><text class="status-text">{{meal.logged ? '已记录' : '待记录'}}</text></view>
        <view class="meal-card-summary"><text class="strong">{{meal.calories}} kcal</text><text>{{meal.foods.length}} 项食物</text><text class="expand-label">{{expandedMeal === mealIndex ? '收起 ↑' : '查看与记录 ↓'}}</text></view>
      </view>
      <view wx:if="{{expandedMeal === mealIndex}}" class="meal-details">
      <view class="nutrition-line">蛋白 {{meal.protein}} g　碳水 {{meal.carbs}} g　脂肪 {{meal.fat}} g　纤维 {{meal.fiberLabel}}</view>
      <view wx:for="{{meal.foods}}" wx:for-item="food" wx:for-index="foodIndex" wx:key="rowKey" class="food-line">
        <view class="topline"><view class="food-main"><view>{{food.name}} <text class="strong">{{food.grams}} {{food.unit || 'g'}}</text></view><view class="badge">{{food.state}}</view></view><button size="mini" class="small-button" data-meal="{{mealIndex}}" data-food="{{foodIndex}}" bindtap="openEditor">修改 / 删除</button></view>
        <view class="muted">{{food.calories}} kcal · 蛋白 {{food.protein}} g · 碳水 {{food.carbs}} g · 脂肪 {{food.fat}} g</view><view class="muted">膳食纤维：{{food.fiberLabel}}</view>
        <view wx:for="{{food.alerts}}" wx:key="*this" class="notice compact-notice">{{item}}</view>
        <view class="badge space">做法参考：{{food.cookingLabel}}</view>
        <view class="actions space"><button size="mini" class="small-button" data-meal="{{mealIndex}}" data-food="{{foodIndex}}" bindtap="collectFood">☆ 收藏食物</button><button size="mini" class="small-button" data-meal="{{mealIndex}}" data-food="{{foodIndex}}" bindtap="showCooking">做法与称重 →</button></view>
      </view>
      <view wx:if="{{!meal.foods.length}}" class="muted space">这餐暂无食物，请添加实际吃的食物。</view>
      <view wx:for="{{meal.alerts}}" wx:key="*this" class="notice compact-notice">{{item}}</view>
      <view class="actions space"><button size="mini" class="small-button" data-meal="{{mealIndex}}" bindtap="collectMeal">保存为常吃搭配</button><button size="mini" class="small-button" data-meal="{{mealIndex}}" bindtap="openLibrary">从我的常吃添加</button></view>
      <view class="actions space"><button wx:if="{{mealIndex > 0}}" size="mini" class="small-button" disabled="{{meal.logged}}" data-meal="{{mealIndex}}" bindtap="copyPreviousMeal">复制上一餐</button><button size="mini" class="small-button" disabled="{{meal.logged}}" data-meal="{{mealIndex}}" bindtap="copyYesterdayMeal">复制昨日同餐</button></view>
      <view class="actions space"><button class="secondary" data-meal="{{mealIndex}}" data-add="yes" bindtap="openEditor">＋ 添加食物</button><button class="{{meal.logged ? 'secondary' : 'primary'}}" data-meal="{{mealIndex}}" bindtap="toggleMeal">{{meal.logged ? '取消这餐记录' : '按以上食物记录这餐'}}</button></view>
      <view wx:if="{{mealFeedback && feedbackMeal === mealIndex}}" class="meal-feedback">
        <view>{{mealFeedback}}</view>
        <button wx:if="{{meal.logged && selectedDate === today && !habit.done}}" class="primary space" bindtap="goCheckin">去完成今日打卡 ↑</button>
      </view>
      <view class="muted space">{{meal.logged ? '已记录餐次也可直接增删食物或修改克数，保存后会自动更新当天合计。' : '没有全吃完？先改成实际克数再记录。额外用油也需添加。'}}</view>
      </view>
    </view>
  </block>
  <view class="footer-tools"><button bindtap="goFoods">食物资料</button><button bindtap="copyYesterday">沿用昨日</button><button bindtap="goBackup">备份记录</button></view>
  <view class="page-footnote">数据默认保存在本机，换设备前请先备份。</view>
</view>
<view wx:if="{{editor}}" class="overlay">
  <scroll-view scroll-y="true" class="editor-sheet">
    <view class="topline"><view class="heading">{{editor.original ? '调整这项食物' : '添加实际食物'}}</view><button size="mini" class="small-button" bindtap="closeEditor">关闭</button></view>
    <view class="muted space">选择食物及称重状态，再填实际克数。生重与熟重不能混用。</view>
    <block wx:if="{{!editor.custom}}">
    <view class="actions space"><button size="mini" class="{{foodCategory === 'all' ? 'primary' : 'secondary'}}" data-category="all" bindtap="onFoodCategory">全部食物</button><button size="mini" class="{{foodCategory === 'staples' ? 'primary' : 'secondary'}}" data-category="staples" bindtap="onFoodCategory">主食 / 薯类 / 粗粮</button></view>
    <view wx:if="{{foodCategory === 'staples'}}" class="muted space">按干重或熟重选择条目；玉米只称玉米粒。换主食可选“尽量保持碳水”，再核对整餐热量。</view>
    <view class="actions space"><button size="mini" class="{{foodCategory === 'vegetables' ? 'primary' : 'secondary'}}" data-category="vegetables" bindtap="onFoodCategory">蔬菜</button><button size="mini" class="{{foodCategory === 'fruits' ? 'primary' : 'secondary'}}" data-category="fruits" bindtap="onFoodCategory">水果</button></view>
    <view wx:if="{{foodCategory === 'vegetables'}}" class="muted space">生重在烹调前称，熟重按条目标明的做法沥水称。未收录熟重的食物请称生重。</view>
    <view wx:if="{{foodCategory === 'fruits'}}" class="muted space">称实际吃下的果肉及可食果皮，不含果核和不吃的皮。</view>
    <view class="label">搜索食物</view><input class="input" value="{{foodQuery}}" bindinput="onFoodSearch" placeholder="例如：菜心、香蕉、米饭" />
    <view class="label">选择食物与称重状态 · {{foodOptions.length}} 项</view>
    <scroll-view wx:if="{{foodOptions.length}}" scroll-y="true" class="food-results">
      <button wx:for="{{foodOptions}}" wx:key="id" class="food-option {{editor.optionIndex === index ? 'active' : ''}}" data-index="{{index}}" bindtap="onSelectFood">{{item.label}}<text>{{editor.optionIndex === index ? '✓' : ''}}</text></button>
    </scroll-view>
    <view wx:else class="notice">暂无匹配食物，请换个名称或分类搜索。</view>
    <block wx:if="{{editor.original ? !editor.original.basis : false}}"><view class="label">替换依据</view><picker range="{{swapModes}}" value="{{editor.modeIndex}}" bindchange="onSwapMode"><view class="select">{{swapModes[editor.modeIndex]}} ▾</view></picker><view class="muted space">原食物：{{editor.original.name}} {{editor.original.grams}} g（{{editor.original.state}}），{{editor.original.calories}} kcal / 蛋白 {{editor.original.protein}} g。</view></block>
    </block>
    <view wx:if="{{editor.custom}}" class="muted space">历史食物：{{editor.original.name}}（{{editor.original.state}}）。保留原营养数据，仅调整原单位份量；新食物从食物库选择。</view>
    <view class="label">实际吃的份量（{{editor.custom ? editor.form.unit : 'g'}}）</view><input class="input" type="digit" value="{{editor.grams}}" bindinput="onSwapGrams" placeholder="输入实际克数" />
    <view wx:if="{{editor.error}}" class="notice">{{editor.error}}</view>
    <view wx:if="{{editor.preview}}" class="preview"><view class="strong">{{editor.preview.calories}} kcal · 蛋白 {{editor.preview.protein}} g</view><view>碳水 {{editor.preview.carbs}} g · 脂肪 {{editor.preview.fat}} g</view><view>膳食纤维：{{editor.preview.fiberLabel || '暂无数据'}}</view><view class="muted">{{editor.preview.note}}</view><view wx:if="{{editor.preview.sourceLabel}}" class="muted">来源：{{editor.preview.sourceLabel}} · {{editor.preview.sourceId}}</view><view wx:for="{{editor.alerts}}" wx:key="*this" class="notice compact-notice">{{item}}</view></view>
    <view class="muted space">营养按所选食物、称重状态和克数计算，数值为近似参考；油和其他食材分别添加。</view>
    <button class="primary space" disabled="{{!editor.preview}}" bindtap="applyEditor">确认并更新整餐营养</button>
    <button wx:if="{{editor.original}}" class="secondary space" bindtap="removeEditorFood">移除这项食物</button>
  </scroll-view>
</view>
<view wx:if="{{library}}" class="overlay"><scroll-view scroll-y="true" class="editor-sheet">
  <view class="topline"><view class="heading">我的常吃</view><button class="small-button" size="mini" bindtap="closeLibrary">关闭</button></view>
  <view class="muted">收藏保存在本机。加入后可改克数，吃完再记录；会追加到餐次，不替换已有食物。</view>
  <view class="label">加入 {{selectedDate}} 的哪一餐？</view><picker range="{{mealNames}}" value="{{library.mealIndex}}" bindchange="onLibraryMeal"><view class="select">{{mealNames[library.mealIndex]}} ▾</view></picker>
  <view wx:if="{{!library.rows.length}}" class="preview">还没有收藏。在餐次里点“收藏食物”或“保存为常吃搭配”，下次就在这里一键添加。</view>
  <view wx:for="{{library.rows}}" wx:key="id" class="food-line"><view class="heading">{{item.name}}</view><text class="badge">{{item.kind === 'meal' ? '整餐搭配' : '常吃食物'}}</text><view class="muted space">{{item.summary}}</view><view class="actions space"><button class="primary" size="mini" data-id="{{item.id}}" bindtap="useFavorite">加入这餐</button><button class="secondary" size="mini" data-id="{{item.id}}" bindtap="removeFavorite">移除收藏</button></view></view>
</scroll-view></view>
<view wx:if="{{recommendation}}" class="overlay"><scroll-view scroll-y="true" class="editor-sheet">
  <view class="topline"><view class="heading">下一餐吃什么</view><button size="mini" class="small-button" bindtap="closeRecommendation">关闭</button></view>
  <view class="label">准备加入哪一餐？</view>
  <picker range="{{recommendation.pending}}" range-key="name" value="{{recommendation.position}}" bindchange="onRecommendationMeal"><view class="select">{{recommendation.pending[recommendation.position].name}} ▾</view></picker>
  <view class="muted space">{{recommendation.explanation}}</view>
  <view class="notice">通用成人搭配参考，不是医疗食谱。含奶、豆、坚果等食材时，请先核对过敏和忌口；特殊饮食需求请遵循专业指导。熟重按所列做法称量，生重食材需做熟再吃。</view>
  <view wx:for="{{recommendation.choices}}" wx:key="id" class="recommend-card">
    <view class="heading">{{item.name}}</view>
    <view class="strong space">{{item.calories}} kcal</view>
    <view class="muted">蛋白 {{item.protein}} g · 碳水 {{item.carbs}} g · 脂肪 {{item.fat}} g</view>
    <view class="muted">膳食纤维：{{item.fiberLabel}}</view>
    <view wx:for="{{item.foods}}" wx:for-item="ingredient" wx:key="id" class="recommend-food">
      <view>{{ingredient.name}} <text class="strong">{{ingredient.grams}} g</text></view>
      <view class="badge">{{ingredient.state}}</view>
      <view class="muted">{{ingredient.note}}</view>
    </view>
    <button class="secondary space" data-id="{{item.id}}" bindtap="chooseRecommendation">采用这套搭配</button>
  </view>
  <view class="muted space">第 {{recommendation.groupNumber}} / {{recommendation.groupCount}} 组 · 共 {{recommendation.totalChoices}} 套搭配</view>
  <button class="primary space" bindtap="rotateRecommendations">{{recommendation.groupNumber === recommendation.groupCount ? '回到第一组' : '换一组搭配'}}</button>
  <view class="muted space">固定搭配分组轮换，不是无限生成。采用后仅加入待记录餐次，不会自动记为已吃；可修改克数，吃完再确认。</view>
</scroll-view></view>
<view wx:if="{{favoriteDraft}}" class="overlay"><view class="editor-sheet"><view class="heading">保存整餐搭配</view><view class="muted space">以后不必逐个搜索食物，加入后仍可按当天实际份量调整。</view><view class="label">给搭配起个名字</view><input class="input" maxlength="40" value="{{favoriteDraft.name}}" bindinput="onFavoriteName" placeholder="例如：豆浆燕麦早餐" /><view class="actions space"><button class="secondary" bindtap="closeFavoriteDraft">取消</button><button class="primary" bindtap="saveMealFavorite">保存搭配</button></view></view></view>
<view wx:if="{{recipe}}" class="overlay"><scroll-view scroll-y="true" class="editor-sheet">
  <view class="topline"><view class="heading">{{recipe.name}}</view><button class="small-button" size="mini" bindtap="closeCooking">关闭</button></view><text class="badge">{{recipe.state}}</text>
  <view class="actions space"><button wx:for="{{recipe.methods}}" wx:key="key" size="mini" class="{{recipe.methodIndex === index ? 'primary' : 'secondary'}}" data-index="{{index}}" bindtap="onCookingMethod">{{item.label}}</button></view>
  <view wx:if="{{recipe.active}}" class="preview"><view class="heading">{{recipe.active.label}} · 操作步骤</view><view wx:for="{{recipe.active.steps}}" wx:key="*this" class="space">{{index + 1}}. {{item}}</view></view>
  <view wx:if="{{recipe.safety}}" class="notice">{{recipe.safety}}</view><view class="muted space">{{recipe.weightNote}}</view><view class="muted space">{{recipe.note}}</view>
</scroll-view></view>
