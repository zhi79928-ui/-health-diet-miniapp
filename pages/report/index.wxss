@import '../../styles/tracking.wxss';
.period-nav { display:flex; align-items:center; justify-content:space-between; gap:18rpx; margin:32rpx 0; text-align:center; }
.period-nav button { min-width:126rpx; }
.period-title { font-size:26rpx; font-weight:700; color:#234c38; line-height:1.6; }
.hero-summary { background:linear-gradient(145deg,#fffdf5,#eaf4ec); }
.report-stats { display:grid; grid-template-columns:repeat(3,1fr); gap:14rpx; margin:32rpx 0 18rpx; }
.report-stats view { text-align:center; color:#607368; font-size:21rpx; }
.report-stats text { display:block; }
.stat-number { color:#176843; font-weight:750; font-size:48rpx; margin-bottom:8rpx; }
.week-grid { display:grid; grid-template-columns:repeat(7,1fr); gap:8rpx; margin-top:28rpx; }
.day-cell { min-width:0; text-align:center; padding:18rpx 2rpx; background:#f2f4f1; color:#87928b; border-radius:14rpx; font-size:18rpx; line-height:1.6; border:2rpx solid transparent; }
.day-cell text { display:block; white-space:nowrap; }
.day-cell.recorded { color:#216347; background:#eaf4ec; }
.day-cell.complete { border-color:#3b956d; }
.day-count { font-size:19rpx; font-weight:650; }
.legend { display:flex; flex-wrap:wrap; gap:28rpx; margin-top:22rpx; color:#718078; font-size:22rpx; }
.dot { display:inline-block; width:16rpx; height:16rpx; border-radius:50%; margin-right:10rpx; }
.recorded-dot { background:#dcefe1; }.complete-dot { background:#3b956d; }
.metric-list { margin-top:18rpx; }
.metric-row { display:flex; justify-content:space-between; align-items:center; gap:24rpx; padding:26rpx 0; border-bottom:2rpx solid #edf1ed; }
.metric-row:last-child { border-bottom:0; }
.metric-label { font-size:27rpx; font-weight:700; color:#263f33; }
.metric-compare { color:#718078; font-size:22rpx; margin-top:8rpx; line-height:1.6; }
.metric-value { flex-shrink:0; color:#176843; font-size:38rpx; font-weight:750; }
.metric-unit { font-size:21rpx; font-weight:500; margin-left:7rpx; }
.body-card { margin-top:26rpx; padding:26rpx; background:#f4f7f2; border-radius:20rpx; }
.body-main { display:grid; grid-template-columns:1fr 1fr; gap:20rpx; margin-top:24rpx; }
.body-value,.body-average { color:#176843; font-size:36rpx; font-weight:750; }
.report-note { margin-bottom:60rpx; }
@media (max-width:350px) { .period-nav { align-items:stretch; flex-wrap:wrap; }.period-nav > view { order:-1; width:100%; }.period-nav button { flex:1; }.week-grid { gap:4rpx; }.day-cell { font-size:16rpx; }.day-count { font-size:17rpx; } }
