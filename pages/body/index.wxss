@import '../../styles/tracking.wxss';
.model-card { margin-top:32rpx; background:#f0f5ef; border-radius:32rpx; overflow:hidden; padding-bottom:28rpx; }
.model-label { text-align:center; color:#32634d; font-size:25rpx; padding:28rpx 16rpx 0; }
.body-canvas { display:block; width:100%; height:760rpx; }
.gesture { text-align:center; color:#687b6e; font-size:23rpx; margin-bottom:24rpx; }
.views { display:flex; gap:16rpx; padding:0 24rpx; }
.views button { flex:1; padding:15rpx 10rpx; background:white; }
.field { display:block; margin-top:32rpx; color:#365b47; font-size:27rpx; }
.field input { margin-top:16rpx; background:#f5f8f4; border:2rpx solid #e1e9df; border-radius:18rpx; height:96rpx; padding:0 24rpx; font-size:30rpx; }
.snapshot { display:block; width:100%; text-align:left; margin-top:24rpx; padding:24rpx; background:#f4f7f1; border-radius:18rpx; font-size:26rpx; line-height:1.6; }
.notice { padding:20rpx; background:#fff5df; color:#845e21; font-size:25rpx; line-height:1.8; }
