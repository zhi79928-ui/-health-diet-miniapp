@import '../../styles/tracking.wxss';
.model-card { margin-top:32rpx; background:#f0f5ef; border-radius:32rpx; overflow:hidden; padding-bottom:28rpx; }
.model-label { text-align:center; color:#32634d; font-size:25rpx; padding:28rpx 16rpx 0; }
.stage { position:relative; height:940rpx; background:radial-gradient(ellipse at 45% 35%,#fcfaf5 0%,#eeeae1 65%,#e2e5dc 100%); }
.body-canvas { display:block; position:relative; width:100%; height:100%; z-index:2; }
.ruler { position:absolute; left:16rpx; top:0; bottom:0; width:66rpx; z-index:1; color:#7c8278; font-size:19rpx; }
.tick { position:absolute; width:100%; border-top:1rpx solid #a5afa2; height:1rpx; }
.tick text { position:absolute; top:-12rpx; background:#efeee7; padding-right:8rpx; }
.ruler-unit { position:absolute; top:3%; }
.head-guide { position:absolute; left:84rpx; right:40rpx; border-top:1rpx dashed #b5bbaa; z-index:1; }
.floor { position:absolute; top:88%; left:24%; width:52%; height:4%; border-radius:50%; background:radial-gradient(ellipse,rgba(66,61,48,.19),rgba(66,61,48,0) 70%); }
.gesture { text-align:center; color:#687b6e; font-size:23rpx; margin-bottom:24rpx; }
.views { display:flex; gap:16rpx; padding:0 24rpx; }
.views button { flex:1; padding:15rpx 10rpx; background:white; }
.rotation-toggle { margin:18rpx 24rpx 0; width:calc(100% - 48rpx); color:#246446; background:rgba(255,255,255,.76); border-radius:16rpx; font-size:24rpx; line-height:1.8; }
.field { display:block; margin-top:32rpx; color:#365b47; font-size:27rpx; }
.field input { margin-top:16rpx; background:#f5f8f4; border:2rpx solid #e1e9df; border-radius:18rpx; height:96rpx; padding:0 24rpx; font-size:30rpx; }
.snapshot { display:block; width:100%; text-align:left; margin-top:24rpx; padding:24rpx; background:#f4f7f1; border-radius:18rpx; font-size:26rpx; line-height:1.6; }
.notice { padding:20rpx; background:#fff5df; color:#845e21; font-size:25rpx; line-height:1.8; }
