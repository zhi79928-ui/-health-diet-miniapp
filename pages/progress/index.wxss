@import "../../styles/tracking.wxss";
@import "../../styles/habits.wxss";
.weight-input { flex: 1; min-width: 100rpx; }
.stats { display: flex; justify-content: space-between; gap: 16rpx; margin: 34rpx 0; text-align: center; }
.stats > view { flex: 1; padding: 20rpx 8rpx; border-radius: 18rpx; background: #f5f8f4; }
.stats .strong { font-size: 36rpx; }
.weight-chart { width: 100%; height: 220px; margin: 16rpx 0 24rpx; }
