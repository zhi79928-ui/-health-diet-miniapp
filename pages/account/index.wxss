@import "../../styles/tracking.wxss";
.account-icon { width: 76rpx; height: 76rpx; flex-shrink: 0; border-radius: 50%; background: #e4f2e6; color: #266044; font-size: 36rpx; text-align: center; line-height: 76rpx; }
.account-row { display: flex; align-items: center; gap: 20rpx; }
.account-main { flex: 1; min-width: 0; }
.backup-status { margin-top: 24rpx; padding: 24rpx; background: #f1f8f3; border-radius: 18rpx; }
.status-label { color: #526759; font-size: 23rpx; }
.status-value { color: #1b6848; font-size: 32rpx; font-weight: 700; margin-top: 10rpx; }
.disclosure { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding: 24rpx 0; margin: 16rpx 0 0; background: transparent; text-align: left; font-size: 25rpx; line-height: 1.6; color: #526759; border-radius: 0; }
.disclosure::after { border: none; }
.disclosure text { flex-shrink: 0; font-size: 23rpx; color: #268b5e; }
.info-panel .disclosure { padding: 4rpx 0; margin: 0; }
.details { border-top: 1rpx solid #edf2ef; padding-top: 16rpx; }
.account-id { word-break: break-all; }
.topline { flex-wrap: wrap; }
.consent { display: flex; align-items: flex-start; margin: 28rpx 0; font-size: 25rpx; line-height: 1.7; }
