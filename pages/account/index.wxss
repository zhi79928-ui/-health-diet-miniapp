@import "../../styles/tracking.wxss";
.body-preview-panel { overflow: hidden; }
.body-preview-stage { position: relative; height: 560rpx; margin-top: 26rpx; overflow: hidden; border-radius: 24rpx; background: radial-gradient(ellipse at 48% 34%, #fffdf8 0%, #f0ece3 66%, #e3e8df 100%); }
.body-preview-canvas { position: relative; z-index: 2; display: block; width: 100%; height: 100%; }
.body-preview-floor { position: absolute; z-index: 1; left: 25%; top: 86%; width: 50%; height: 6%; border-radius: 50%; background: radial-gradient(ellipse, rgba(66,61,48,.2), rgba(66,61,48,0) 70%); }
.body-preview-label { position: absolute; z-index: 3; top: 22rpx; left: 22rpx; right: 22rpx; color: #275e43; font-size: 23rpx; text-align: center; pointer-events: none; }
.body-preview-tip { position: absolute; z-index: 3; left: 50%; bottom: 20rpx; transform: translateX(-50%); min-width: 250rpx; padding: 10rpx 22rpx; border-radius: 999rpx; color: #315f48; background: rgba(255,255,255,.82); font-size: 21rpx; text-align: center; pointer-events: none; }
.account-icon { width: 76rpx; height: 76rpx; flex-shrink: 0; border-radius: 50%; background: #e4f2e6; color: #266044; font-size: 36rpx; text-align: center; line-height: 76rpx; }
.account-row { display: flex; align-items: center; gap: 26rpx; }
.account-main { flex: 1; min-width: 0; }
.backup-status { margin-top: 30rpx; padding: 30rpx; background: #f1f8f3; border-radius: 20rpx; }
.danger-button { color: #9a3e37; background: #fff1ef; border-radius: 20rpx; font-size: 27rpx; padding: 23rpx 18rpx; line-height: 1.65; }
.status-label { color: #526759; font-size: 23rpx; }
.status-value { color: #1b6848; font-size: 32rpx; font-weight: 700; margin-top: 10rpx; }
.disclosure { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding: 30rpx 0; margin: 20rpx 0 0; background: transparent; text-align: left; font-size: 27rpx; line-height: 1.7; color: #526759; border-radius: 0; }
.disclosure::after { border: none; }
.disclosure text { flex-shrink: 0; font-size: 23rpx; color: #268b5e; }
.info-panel .disclosure { padding: 4rpx 0; margin: 0; }
.details { border-top: 1rpx solid #edf2ef; padding-top: 24rpx; }
.account-id { word-break: break-all; }
.topline { flex-wrap: wrap; }
.consent { display: flex; align-items: flex-start; margin: 28rpx 0; font-size: 25rpx; line-height: 1.7; }
